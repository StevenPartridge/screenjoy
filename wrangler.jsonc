{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "screenjoy",
  "compatibility_date": "2026-09-16",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "screenjoy.didish.art", "custom_domain": true }],
  "assets": {
    "directory": "./dist/site",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "build": {
    "command": "npm run site:build && npm run site:check"
  }
}
